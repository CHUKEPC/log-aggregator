# Application settings
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Security & Authentication
SECRET_KEY=change-me-to-a-secure-secret-key-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword

# API Keys (service_name:api_key, comma separated)
API_KEYS=auth-service:secret-auth-key,payment-service:secret-payment-key,frontend:secret-frontend-key

# Elasticsearch Configuration
ELASTICSEARCH_HOSTS=http://elasticsearch:9200
ELASTICSEARCH_INDEX_PREFIX=logs
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_VERIFY_CERTS=false

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=600

# Retention Policy (days to keep logs, 0 = unlimited)
RETENTION_DAYS=30

# TCP Socket Server
TCP_SERVER_ENABLED=true
TCP_SERVER_HOST=0.0.0.0
TCP_SERVER_PORT=9000
